# OPS-3A.4A — Mobile environment selection (EXAMPLE, non-secret)
#
# Copy to a local env file (e.g. .env.local, which is gitignored) or supply
# these via the EAS build profile's `env` block. Expo SDK 54 inlines
# EXPO_PUBLIC_* variables at build/bundle time.
#
# IMPORTANT: these are NON-SECRET client configuration identifiers only
# (public REST API URL, Cognito pool/app-client IDs, AWS region). Do NOT put
# access tokens, passwords, JWTs, client secrets, or AWS credentials here.
#
# A build MUST declare its environment explicitly. There is NO implicit
# production default — an unset/invalid APP_ENV fails closed at startup.
#
# EAS build-worker delivery (eas.json `env` blocks set the var on the remote
# builder — a local shell var or gitignored .env.local is NOT uploaded):
#   - development        -> env EXPO_PUBLIC_APP_ENV=development (fails closed; no dev backend)
#   - preview            -> NO env baked -> fails closed; never silently production
#   - preview-production -> extends preview + explicit EXPO_PUBLIC_APP_ENV=production
#                           (the deterministic Matthew-only internal prod-backed build:
#                            `eas build --profile preview-production`)
#   - production         -> explicit EXPO_PUBLIC_APP_ENV=production (store builds; gated)
#
# Eventual model (NOT created yet): named EAS environments
# (development/preview/production) can later hold these non-secret EXPO_PUBLIC_*
# values; a `development` EAS environment must stay fail-closed until a real
# PetCare Hero dev backend exists.

# Required. One of: production | development
#   production  -> explicit production-backed build (API/Cognito below)
#   development -> RESERVED. No PetCare Hero dev backend exists for this app yet;
#                  selecting it fails closed until a real dev environment exists.
EXPO_PUBLIC_APP_ENV=production

# Optional overrides for a production build. When omitted, the canonical
# non-secret production identifiers baked into src/api/config.ts are used.
# EXPO_PUBLIC_API_URL=https://a022yxuiue.execute-api.us-east-1.amazonaws.com/prod
# EXPO_PUBLIC_COGNITO_REGION=us-east-1
# EXPO_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_counlsXGU
# EXPO_PUBLIC_COGNITO_CLIENT_ID=1u4t7rfo339nkcgaf6q8s8sc6u
